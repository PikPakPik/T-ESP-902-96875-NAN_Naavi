            class="welcome-subtitle"
          >
          </p>
        </div>
      </div>
      <div
        class="form-section"
      >
        <div
          class="form-container"
        >
          <div
            class="logo-section"
          >
            <i
              class="pi pi-mountain"
              style="font-size: 3rem; color: var(--primary-color);"
            />
            <h2>
            </h2>
            <p
              class="subtitle"
            >
            </p>
          </div>
          <form
            class="login-form"
            novalidate=""
          >
            <div
              class="field"
            >
              <label
                for="email"
              >
              </label>
              <input
                class="w-full"
                formcontrolname="email"
                id="email"
                pinputtext=""
              />
            </div>
            <div
              class="field"
            >
              <label
                for="password"
              >
              </label>
              <p-password
                formcontrolname="password"
                inputstyleclass="w-full"
              >
                <input
                  pinputtext=""
                />
                <p-overlay>
                </p-overlay>
              </p-password>
            </div>
            <div
              class="field mb-4"
            >
              <div
                id="turnstile-widget"
              />
            </div>
            <div
              class="flex justify-between items-center mb-6"
            >
              <div
                class="flex items-center"
              >
                <p-checkbox
                  formcontrolname="rememberMe"
                  inputid="rememberMe"
                >
                  <input
                    type="checkbox"
                  />
                  <div>
                  </div>
                </p-checkbox>
                <label
                  class="ml-2 text-sm"
                  for="rememberMe"
                >
                </label>
              </div>
              <a
                class="text-green-600 hover:text-green-800 text-sm font-medium cursor-pointer transition-colors"
                role="button"
                tabindex="0"
              >
              </a>
            </div>
            <p-button
              class="w-full login-button"
              type="submit"
            >
              <button
                class="p-ripple"
                pripple=""
              >
              </button>
            </p-button>
          </form>
        </div>
      </div>
    </div>
  </div><p-dialog
    class="forgot-password-dialog"
    header=""
  >
  </p-dialog>
</web-auth-feature>
`;

