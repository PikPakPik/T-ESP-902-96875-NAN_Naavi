{
  "name": "backoffice",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "",
  "sourceRoot": "apps/backoffice/src",
  "tags": ["type:app", "scope:backoffice"],
  "targets": {
    "build": {
      "executor": "@nx/angular:application",
      "options": {
        "tsConfig": "apps/backoffice/tsconfig.app.json",
        "outputPath": "dist/apps/backoffice",
        "index": "apps/backoffice/src/index.html",
        "browser": "apps/backoffice/src/main.ts",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/backoffice/public"
          },
          {
            "glob": "**/*",
            "input": "apps/backoffice/src/assets",
            "output": "assets"
          },
          {
            "glob": "**/*",
            "input": "shared-assets",
            "output": "assets"
          }
        ],
        "styles": [
          "apps/backoffice/src/styles.scss",
          "node_modules/primeicons/primeicons.css"
        ],
        "scripts": [],
        "allowedCommonJsDependencies": ["wkx-ts", "buffer"]
      },
      "configurations": {
        "production": {
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/backoffice/src/environments/environment.ts",
              "with": "apps/backoffice/src/environments/environment.prod.ts"
            }
          ]
        },
        "develop": {
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/backoffice/src/environments/environment.ts",
              "with": "apps/backoffice/src/environments/environment.dev.ts"
            }
          ]
        },
        "development": {
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@nx/angular:dev-server",
      "options": {
        "buildTarget": "backoffice:build:development",
        "open": false,
        "host": "0.0.0.0"
      }
    },
    "extract-i18n": {
      "executor": "@nx/angular:extract-i18n",
      "options": {
        "buildTarget": "backoffice:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["{projectRoot}/**/*.{ts,html}"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/backoffice/jest.config.ts",
        "tsConfig": "apps/backoffice/tsconfig.spec.json"
      }
    },
    "docker": {
      "executor": "@nx-tools/nx-container:build",
      "options": {
        "push": true,
        "metadata": {
          "images": [
            "registry.gitlab.com/epitech-msc-2026/frontend/web/backoffice"
          ],
          "tags": ["type=sha,prefix=", "type=raw,linux-${TAG}"],
          "platforms": ["linux/amd64", "linux/arm64"]
        }
      }
    }
  }
}
