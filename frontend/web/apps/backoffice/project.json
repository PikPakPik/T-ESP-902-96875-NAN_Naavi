{
  "name": "backoffice",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/backoffice/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/backoffice",
        "index": "apps/backoffice/src/index.html",
        "browser": "apps/backoffice/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/backoffice/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/backoffice/public"
          },
          {
            "glob": "**/*",
            "input": "apps/backoffice/src/assets",
            "output": "assets"
          },
          {
            "glob": "**/*",
            "input": "shared-assets",
            "output": "assets"
          }
        ],
        "styles": [
          "apps/backoffice/src/styles.scss",
          "node_modules/primeicons/primeicons.css"
        ],
        "scripts": [],
        "server": "apps/backoffice/src/main.server.ts",
        "ssr": {
          "entry": "apps/backoffice/src/server.ts"
        },
        "prerender": true
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "maximumError": "5mb",
              "maximumWarning": "2mb",
              "type": "initial"
            },
            {
              "maximumError": "70kb",
              "maximumWarning": "6kb",
              "type": "anyComponentStyle"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "backoffice:build:production"
        },
        "development": {
          "buildTarget": "backoffice:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "backoffice:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/backoffice/jest.config.ts"
      }
    },
    "docker": {
      "executor": "@nx-tools/nx-container:build",
      "options": {
        "push": true,
        "metadata": {
          "images": [
            "registry.gitlab.com/epitech-msc-2026/frontend/web/backoffice"
          ],
          "tags": ["type=sha,prefix=", "type=raw,linux-${TAG}"],
          "platforms": ["linux/amd64", "linux/arm64"]
        }
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/backoffice:file-server",
      "options": {
        "buildTarget": "backoffice:build",
        "port": 4200,
        "staticFilePath": "dist/apps/backoffice/browser",
        "spa": true
      }
    }
  }
}
