# Mapbox Configuration
# Get your token at: https://www.mapbox.com/account/access-tokens
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# Cloudflare Turnstile Configuration
# Get your site key at: https://dash.cloudflare.com/?to=/:account/turnstile
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# Backoffice: Base URL for S3/MinIO images (profile pictures)
# Example: https://s3.naavi.local/naavi-images
VITE_IMAGES_BASE_URL=https://s3.naavi.local/naavi-images
