# Fastfile - Lanes Fastlane pour iOS CI/CD
# Documentation: https://docs.fastlane.tools

default_platform(:ios)

platform :ios do
  
  # ============================================
  # Helper pour trouver l'IPA
  # ============================================
  
  def find_ipa_path
    # Chemins possibles pour l'IPA
    possible_paths = [
      "../build/ios/ipa/*.ipa",
      "../build/ios/ipa/naavi.ipa",
      "#{ENV['CI_PROJECT_DIR']}/build/ios/ipa/*.ipa"
    ]
    
    possible_paths.each do |pattern|
      files = Dir[pattern]
      if files.any?
        UI.message("✅ Found IPA at: #{files.first}")
        return files.first
      end
    end
    
    # Debug: afficher le contenu du répertoire
    UI.message("🔍 Looking for IPA files...")
    UI.message("Current directory: #{Dir.pwd}")
    
    if Dir.exist?("../build/ios/ipa")
      UI.message("Contents of ../build/ios/ipa/:")
      Dir["../build/ios/ipa/*"].each { |f| UI.message("  - #{f}") }
    else
      UI.message("❌ Directory ../build/ios/ipa/ does not exist")
    end
    
    nil
  end

  # ============================================
  # Configuration du keychain pour CI/CD
  # ============================================
  
  desc "Crée le keychain temporaire pour CI/CD"
  lane :setup_keychain do
    if is_ci?
      keychain_path = File.expand_path("~/Library/Keychains/fastlane_keychain-db")
      unless File.exist?(keychain_path)
        create_keychain(
          name: "fastlane_keychain",
          password: ENV["MATCH_KEYCHAIN_PASSWORD"],
          default_keychain: true,
          unlock: true,
          timeout: 3600,
          lock_when_sleeps: false
        )
      end
    end
  end

  # Lane pour télécharger les certificats (appelée par CI)
  desc "Installe les certificats et provisioning profiles"
  lane :certificates do
    setup_keychain
    
    match(
      type: "appstore",
      readonly: is_ci?,
      keychain_name: "fastlane_keychain",
      keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"]
    )
  end

  # ============================================
  # Configuration API App Store Connect
  # ============================================
  
  private_lane :get_api_key do
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: true
    )
  end

  # ============================================
  # Déploiement TestFlight - [DEV] (branche develop)
  # ============================================
  
  desc "Déploie sur TestFlight avec le préfixe [DEV] pour la branche develop"
  lane :deploy_testflight_dev do |options|
    api_key = get_api_key
    
    # Récupérer les informations de commit pour le changelog
    commit_sha = ENV["CI_COMMIT_SHORT_SHA"] || `git rev-parse --short HEAD`.strip
    commit_message = ENV["CI_COMMIT_MESSAGE"] || `git log -1 --pretty=%B`.strip
    branch_name = ENV["CI_COMMIT_REF_NAME"] || `git branch --show-current`.strip
    build_number = ENV["CI_PIPELINE_IID"] || Time.now.strftime("%Y%m%d%H%M")
    
    changelog = "[DEV] Build ##{build_number}\n\n" \
                "Branch: #{branch_name}\n" \
                "Commit: #{commit_sha}\n\n" \
                "#{commit_message}"
    
    # Trouver l'IPA
    ipa_path = options[:ipa] || find_ipa_path
    
    UI.user_error!("❌ No IPA file found! Make sure build_ios_dev ran successfully.") unless ipa_path
    
    UI.message("📱 Uploading to TestFlight [DEV]...")
    UI.message("📦 IPA: #{ipa_path}")
    UI.message("📝 Changelog:\n#{changelog}")
    
    pilot(
      api_key: api_key,
      ipa: ipa_path,
      changelog: changelog,
      distribute_external: true,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      groups: ["Naavi", "Naavi External"]
    )
    
    UI.success("✅ Upload TestFlight [DEV] terminé!")
  end

  # ============================================
  # Déploiement App Store - Tags
  # ============================================
  
  desc "Déploie sur l'App Store pour les tags de release"
  lane :deploy_appstore do |options|
    api_key = get_api_key
    
    # Récupérer les informations du tag
    tag_name = ENV["CI_COMMIT_TAG"] || `git describe --tags --abbrev=0`.strip
    
    # Trouver l'IPA
    ipa_path = options[:ipa] || find_ipa_path
    
    UI.user_error!("❌ No IPA file found! Make sure build_ios_prod ran successfully.") unless ipa_path
    
    UI.message("🚀 Uploading to App Store...")
    UI.message("📦 IPA: #{ipa_path}")
    UI.message("🏷️  Tag: #{tag_name}")
    
    # Upload vers l'App Store
    deliver(
      api_key: api_key,
      ipa: ipa_path,
      skip_screenshots: true,
      skip_metadata: true,
      submit_for_review: false,
      automatic_release: false,
      force: true
    )
    
    UI.success("✅ Upload App Store terminé pour la version #{tag_name}!")
  end
end
